    end,
})

Movement:AddSlider("JumpPowerValue", {
    Text = "JumpPower",
    Default = 50,
    Min = 0,
    Max = 345,
    Rounding = 0,
    Callback = function(value)
        Settings.JumpPower = value
        if Settings.JumpPowerEnabled then
            applyMovement()
        end
    end,
})

-- Stretched: this is a camera-matrix distortion, not a true display-resolution change.
local function stopStretched()
    pcall(function()
        RunService:UnbindFromRenderStep("KlzHub_Stretched")
    end)
end

local function startStretched()
    stopStretched()

    RunService:BindToRenderStep(
        "KlzHub_Stretched",
        Enum.RenderPriority.Camera.Value + 1,
        function()
            if not Settings.Stretched then
                return
            end

            local camera = workspace.CurrentCamera
            if not camera then
                return
            end

            local cf = camera.CFrame
            local intensity = Settings.StretchIntensity

            camera.CFrame = CFrame.fromMatrix(
                cf.Position,
                cf.RightVector,
                cf.UpVector * intensity,
                cf.ZVector
            )
        end
    )
end

Display:AddToggle("StretchedEnabled", {
    Text = "Stretched",
    Default = false,
    Callback = function(value)
        Settings.Stretched = value
        if value then
            startStretched()
        else
            stopStretched()
        end
    end,
})

Display:AddSlider("StretchedIntensity", {
    Text = "Stretch Intensity",
    Default = 0.75,
    Min = 0.5,
    Max = 1.2,
    Rounding = 2,
    Callback = function(value)
        Settings.StretchIntensity = value
    end,
})

-- Noclip. Disable collision before each physics simulation and also
-- handle parts added later or a freshly spawned character.
local noclipConnection
local noclipDescendantConnection
local noclipCharacter
local originalCollision = setmetatable({}, { __mode = "k" })

local function makePartNonCollidable(instance)
    if not instance:IsA("BasePart") then
        return
    end

    if originalCollision[instance] == nil then
        originalCollision[instance] = instance.CanCollide
    end
    instance.CanCollide = false
end

local function watchNoclipCharacter(character)
    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end

    noclipCharacter = character
    if not character then
        return
    end

    for _, instance in ipairs(character:GetDescendants()) do
        makePartNonCollidable(instance)
    end

    noclipDescendantConnection = character.DescendantAdded:Connect(function(instance)
        if Settings.Noclip then
            makePartNonCollidable(instance)
        end
    end)
end

local function setNoclip(enabled)
    Settings.Noclip = enabled

    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if noclipDescendantConnection then
        noclipDescendantConnection:Disconnect()
        noclipDescendantConnection = nil
    end
    noclipCharacter = nil

    if enabled then
        watchNoclipCharacter(LocalPlayer.Character)

        -- PreSimulation is preferred; Stepped is a fallback for older clients.
        local physicsSignal = RunService.PreSimulation or RunService.Stepped
        noclipConnection = physicsSignal:Connect(function()
            local character = LocalPlayer.Character
            if character ~= noclipCharacter then
                watchNoclipCharacter(character)
            end
            if not character then
                return
            end

            -- Reapply every physics frame in case another local script resets it.
            for _, instance in ipairs(character:GetDescendants()) do
                makePartNonCollidable(instance)
            end
        end)
    else
        for part, canCollide in pairs(originalCollision) do
            if part and part.Parent then
                part.CanCollide = canCollide
            end
            originalCollision[part] = nil
        end
    end
end

Utilities:AddToggle("NoclipEnabled", {
    Text = "Noclip",
    Default = false,
    Callback = function(value)
        setNoclip(value)
    end,
})

-- TP Tool. Equip it, then click/tap a spot to move there.
local tpTool
local mouse = LocalPlayer:GetMouse()

local function removeTPTool()
    Settings.TPTool = false
    if tpTool then
        tpTool:Destroy()
        tpTool = nil
    end
end

local function createTPTool()
    if not Settings.TPTool then
        return
    end

    if tpTool then
        tpTool:Destroy()
        tpTool = nil
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        or LocalPlayer:WaitForChild("Backpack")

    local tool = Instance.new("Tool")
    tool.Name = "TP Tool"
    tool.ToolTip = "Equip and click a location to teleport"
    tool.RequiresHandle = false
    tool.CanBeDropped = false

    tool.Activated:Connect(function()
        if not Settings.TPTool then
            return
        end

        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local root = character and character:FindFirstChild("HumanoidRootPart")

        if not character or not humanoid or humanoid.Health <= 0 or not root then
            return
        end

        local hit = mouse.Hit
        if hit then
            local rotation = root.CFrame - root.Position
            character:PivotTo(CFrame.new(hit.Position + Vector3.new(0, 3, 0)) * rotation)
        end
    end)

    tpTool = tool
    tool.Parent = backpack
end

Utilities:AddToggle("TPToolEnabled", {
    Text = "TP Tool",
    Default = false,
    Callback = function(value)
        Settings.TPTool = value

        if value then
            createTPTool()
        else
            removeTPTool()
        end
    end,
})

LocalPlayer.CharacterAdded:Connect(function(character)
    task.spawn(function()
        local humanoid = character:WaitForChild("Humanoid", 10)
        if humanoid then
            cacheHumanoid(humanoid)
            applyMovement()
        end

        if Settings.TPTool then
            createTPTool()
        end
    end)
end)

local currentHumanoid = getHumanoid()
if currentHumanoid then
    cacheHumanoid(currentHumanoid)
end

