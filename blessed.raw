--------------------------------------------------
-- LOCALPLAYER: MOVEMENT, DISPLAY, UTILITIES
--------------------------------------------------

local Movement = Tabs.LocalPlayer:AddLeftGroupbox("Movement")
local Display = Tabs.LocalPlayer:AddRightGroupbox("Display")
local Utilities = Tabs.LocalPlayer:AddRightGroupbox("Utilities")

local OriginalValues = setmetatable({}, { __mode = "k" })

local function getHumanoid()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end
    return character:FindFirstChildOfClass("Humanoid")
end

local function cacheHumanoid(humanoid)
    if not humanoid or OriginalValues[humanoid] then
        return
    end

    OriginalValues[humanoid] = {
        WalkSpeed = humanoid.WalkSpeed,
        JumpPower = humanoid.JumpPower,
        UseJumpPower = humanoid.UseJumpPower,
    }
end

local function applyMovement()
    local humanoid = getHumanoid()
    if not humanoid then
        return
    end

    cacheHumanoid(humanoid)
    local original = OriginalValues[humanoid]

    if Settings.WalkSpeedEnabled then
        humanoid.WalkSpeed = Settings.WalkSpeed
    else
        humanoid.WalkSpeed = original.WalkSpeed
    end

    if Settings.JumpPowerEnabled then
        humanoid.UseJumpPower = true
        humanoid.JumpPower = Settings.JumpPower
    else
        humanoid.JumpPower = original.JumpPower
        humanoid.UseJumpPower = original.UseJumpPower
    end
end

Movement:AddToggle("WalkSpeedEnabled", {
    Text = "Enable WalkSpeed",
    Default = false,
    Callback = function(value)
        Settings.WalkSpeedEnabled = value
        applyMovement()
    end,
})

Movement:AddSlider("WalkSpeedValue", {
    Text = "WalkSpeed",
    Default = 16,
    Min = 0,
    Max = 345,
    Rounding = 0,
    Callback = function(value)
        Settings.WalkSpeed = value
        if Settings.WalkSpeedEnabled then
            applyMovement()
        end
    end,
})

Movement:AddToggle("JumpPowerEnabled", {
    Text = "Enable JumpPower",
    Default = false,
    Callback = function(value)
